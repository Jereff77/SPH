# ============================================================================
# Variables de entorno — ERP SPH v2 (plantilla). Copiar a .env y rellenar.
# NUNCA commitear el .env real. El service_role NUNCA debe llegar al frontend.
# ============================================================================

# ---- Backend (apps/api) ----------------------------------------------------
# URL del proyecto Supabase
SUPABASE_URL=https://szjlkvakwljssdnysazp.supabase.co
# Clave service_role: SOLO en el servidor (apps/api). Acceso total, salta RLS.
SUPABASE_SERVICE_ROLE_KEY=__rellenar_solo_en_servidor__
# Clave anónima (para validar/decodificar JWTs de usuario si se usa el SDK)
SUPABASE_ANON_KEY=__rellenar__
# Secreto JWT de Supabase (Project Settings > API > JWT Secret) para verificar tokens
SUPABASE_JWT_SECRET=__rellenar__
# Puerto del backend
API_PORT=3001
# Origen permitido para CORS (el frontend)
CORS_ORIGIN=http://localhost:5173

# ---- Frontend (apps/web) ---------------------------------------------------
# Solo variables con prefijo VITE_ se exponen al navegador.
# El frontend NUNCA recibe el service_role: solo conoce la URL del backend.
VITE_API_URL=http://localhost:3001
