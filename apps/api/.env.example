# Backend NestJS — copiar a apps/api/.env y rellenar. NUNCA commitear el .env real.

# Supabase
SUPABASE_URL=https://szjlkvakwljssdnysazp.supabase.co
# service_role: acceso total, salta RLS. SOLO en el servidor. NUNCA exponer al frontend.
SUPABASE_SERVICE_ROLE_KEY=__rellenar__
# anon key: usada SOLO server-side para el flujo de auth (login/refresh). No para datos.
SUPABASE_ANON_KEY=__rellenar__
# Secreto para verificar la firma de los JWT de usuario (Supabase > Settings > API > JWT Secret)
SUPABASE_JWT_SECRET=__rellenar__

# Dominios de correo autorizados (el login pide solo el usuario; el backend resuelve el correo)
DOMINIOS_AUTORIZADOS=aceleremos.com,gruposph.mx

# Token de la SIE API de Banxico (tipo de cambio FIX USD/MXN, serie SF43718). El
# backend hace de proxy; el token nunca llega al frontend. Tiene default en el código.
BANXICO_TOKEN=__rellenar_o_usar_default__

# Módulo Correo: clave maestra para cifrar (AES-256-GCM) las contraseñas de las cuentas
# de correo. Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# ⚠️ DEFINITIVA (si cambia, no se descifran las cuentas ya guardadas) y la MISMA en todos
# los entornos que apunten a la misma BD.
EMAIL_ENCRYPTION_KEY=__rellenar__

# Invitaciones de registro de usuarios
# URL base del frontend para construir el link del correo: {APP_WEB_URL}/registro?token=XXX
# Si se omite, cae a CORS_ORIGIN. En producción debe ser la URL pública del front.
APP_WEB_URL=http://localhost:5173
# Cuenta SMTP DEDICADA para enviar las invitaciones (independiente del buzón de facturas).
# Si SMTP_INVITACIONES_HOST queda vacío, el envío de invitaciones se deshabilita.
SMTP_INVITACIONES_HOST=
SMTP_INVITACIONES_PORT=587
SMTP_INVITACIONES_USER=
SMTP_INVITACIONES_PASS=
# Remitente (From) mostrado al destinatario. Si se omite, se usa SMTP_INVITACIONES_USER.
SMTP_INVITACIONES_FROM=
# Días de validez del link de invitación
INVITACION_VIGENCIA_DIAS=7

# Servidor
API_PORT=3001
CORS_ORIGIN=http://localhost:5173
NODE_ENV=development
