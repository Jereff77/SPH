# Backend NestJS — copiar a apps/api/.env y rellenar. NUNCA commitear el .env real.

# Supabase
SUPABASE_URL=https://szjlkvakwljssdnysazp.supabase.co
# service_role: acceso total, salta RLS. SOLO en el servidor. NUNCA exponer al frontend.
SUPABASE_SERVICE_ROLE_KEY=__rellenar__
# anon key: usada SOLO server-side para el flujo de auth (login/refresh). No para datos.
SUPABASE_ANON_KEY=__rellenar__
# Secreto para verificar la firma de los JWT de usuario (Supabase > Settings > API > JWT Secret)
SUPABASE_JWT_SECRET=__rellenar__

# Dominios de correo autorizados (el login pide solo el usuario; el backend resuelve el correo)
DOMINIOS_AUTORIZADOS=aceleremos.com,gruposph.mx

# Token de la SIE API de Banxico (tipo de cambio FIX USD/MXN, serie SF43718). El
# backend hace de proxy; el token nunca llega al frontend. Tiene default en el código.
BANXICO_TOKEN=__rellenar_o_usar_default__

# Servidor
API_PORT=3001
CORS_ORIGIN=http://localhost:5173
NODE_ENV=development
