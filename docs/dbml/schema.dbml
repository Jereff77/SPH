  "id" uuid [pk, default: `gen_random_uuid()`]
  "uidr" uuid [ref: < "public"."catUsers"."uid"]
  "status" boolean [default: true]
  "fc" timestamp [not null, default: `now()`]
  "nombreLead" text
  "telefono" text
  "correo" text
  "idInmobiliaria" uuid [ref: < "public"."catInmobiliarias"."idInmobiliaria"]
  "fechaContacto" timestamp [default: `now()`]
  "fechaRegistro" timestamptz
  "mensaje" text
  "uidRC" uuid [ref: < "public"."catUsers"."uid"] // Responsable comercial
  "idEtapa" bigint [ref: < "public"."crm_Etapas"."id"]
  "idOrigen" bigint [ref: < "public"."crm_Origen"."id"]
  "idTipoCliente" bigint [ref: < "public"."crm_tipoCliente"."id"]
  "idTipoOperacion" bigint [ref: < "public"."crm_tipoOperaciones"."id"]
  "idTipoVenta" bigint [ref: < "public"."crm_tipoVenta"."id"]
  "Etapa" text
  "Origen" text
  "tipoCliente" text
  "tipoOperacion" text
  "tipoVenta" text
  "nomRC" text [default: 'Sin asignar']
  "valor" double [default: 0]
  "aprobado" boolean
  "idAsesorInm" uuid [ref: < "public"."catAsesoresInm"."id"]
  "superficie" text
  "KVAs" text
  "ubicacion" text [default: 'Indistinto']
  "personaFisica" boolean
}

