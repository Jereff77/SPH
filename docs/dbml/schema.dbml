Table "public"."cxp_fechas_habilitadas" {
  "fecha" date [pk]
  "created_by" uuid [default: '00000000-0000-0000-0000-000000000000']
  "created_at" timestamp [not null, default: `now()`]
  "cfdi" boolean [default: false]
  "autorizar" boolean [default: true]
  "dia_semana" text
  "mes_anio" text // Generada: ((lpad((EXTRACT(month FROM fecha))::text, 2, '0'::text) || '-'::text) || (EXTRACT(year FROM fecha))::text)
}

