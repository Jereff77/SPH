Table "public"."movbancarios" {
  "idmov" text [pk]
  "fc" timestamptz [not null, default: `now()`]
  "asunto" text
  "genero" text
  "fecOperacion" date
  "horaOperacion" time
  "ordenante" text
  "ctaDestino" text
  "bcoDestino" text
  "beneficiario" text
  "aplicar" text
  "importe" double
  "cancepto" text
  "referencia" text
  "autorizacion" text
  "rastreo" text [unique]
  "uidAsignado" text
  "tipo" text [default: 'Transferencias']
  "bancoEmisor" text
  "aplicado" boolean [default: false]
  "folioCFDI" text // UUID de la factura a la que se le aplico el pago
  "numAnio" integer // Generada: EXTRACT(year FROM "fecOperacion")
  "numMes" integer // Generada: EXTRACT(month FROM "fecOperacion")
  "idArrePdp" text // El id del arrendamiento separado por un - y el numero de la partida
  "idtipo" integer // Generada: CASE WHEN (tipo = 'Transferencia'::text) THEN 1 WHEN (tipo = 'Transferencias'::text) THEN 1 ELSE 2 END
  "imgComp" text
  "manual" boolean [default: false]
  "Operacion" text [default: 'Transferencia Interbancaria SPEI']
  "moneda" text [default: 'MNX']
