Table "public"."arreConceptos" {
  "fc" timestamp [not null, default: `now()`]
  "uid" text
  "idArreConcepto" text [pk]
  "status" boolean [default: true]
  "idArrendador" text
  "idArrePdp" text [ref: < "public"."arrePdp"."idArrePdp"]
  "concepto" text
  "mInicio" integer
  "periodo" integer
  "monto" double
}

Table "public"."arrePdp" {
  "idArrePdp" text [pk, not null]
  "uid" uuid [ref: < "public"."catUsers"."uid"]
  "fc" timestamptz [not null, default: `now()`]
  "status" boolean [default: true]
  "idArrendador" text [not null, ref: < "public"."inversionista"."idInversionista">]
  "idNavArrend" text [not null, ref: < "public"."arrenPropiedades"."idNavArrend">]
  "fecInicio" date
  "plazo" smallint
  "deposito" double
  "precioM2" real
  "construccionM2" real
  "rtaBase" double
  "INPC" double [not null, default: 0]
  "INPCPlus" double [not null, default: 0]
  "pm2Admin" double [not null, default: 0]
  "pm2Mtto" double [not null, default: 0]
  "pm2Vig" double [not null, default: 0]
  "fecFin" date // Generada: ("fecInicio" + ((plazo)::double precision * '1 mon'::interval))
  "vigente" boolean [default: true]
  "Moneda" text [not null, default: 'MXN']
  "mesGracia" jsonb [not null, default: '{"renta": 0.0, "vigilancia": 0.0, "mantenimiento": 0.0, "administracion": 0.0}'] // meses de gracia
  "arrePdpVigente" "arrePdpVigente" [not null, default: 'Si']
}

Table "public"."arrePdpDetalle" {
  "idArrePdpDet" text [pk]
  "fc" timestamptz [not null, default: `now()`]
  "status" boolean [default: true]
  "uidc" uuid [ref: < "public"."catUsers"."uid"] // usuario creo registro
  "idArrePdp" text [ref: < "public"."arrePdp"."idArrePdp"]
  "tipoOperacion" bigint [ref: < "public"."catTipoOperacion"."id"]
  "numPartida" integer
  "concepto" text
  "fecha" timestamp
  "pm2" numeric [default: 0]
  "constM2" numeric [default: 0]
  "comprobantePago" text [default: '']
  "INPC" numeric [default: 0]
  "ptsINPC" numeric [default: 0]
  "anio" smallint [default: 0]
  "montoDividido" boolean [default: false] // True cuendo el monto se dividio entre los meses del periodo
  "UltimoPago" boolean [default: false]
  "ciclo" integer // el ciclo se marca con el año del inicio del periodo
  "inc_x_inpc" double [default: 0]
  "cantidadAplicada" double [default: 0] // pago recibido por el arrendador
  "uidPago" uuid // usuario registro el pago
  "fecPago" date // fecha en que se realizo el pago
  "cantidad2" real [default: 0]
  "inpcTotal" numeric // Generada: ("INPC" + "ptsINPC")
  "cantidad" numeric // Generada: (pm2 * "constM2")
  "moneda" text [default: 'MXN']
  "tieneMesGratis" "mesGratis" [default: 'No'] // Indica si en el pago lo tiene gratis o medio mes gratis
  "idRtaA" text
  "comSPH" real [default: 0]
}

