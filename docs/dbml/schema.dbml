// Enums personalizados
Enum "public"."Area" {
  "Modulo"
  "Opcion"
}

Enum "public"."Modulos" {
  "Arrendatarios"
  "Comisiones"
  "Configuraciones"
  "CRM"
  "Cuentas por Pagar"
  "Fideicomiso"
  "Inversionistas"
  "Parques"
}

Enum "public"."mesGratis" {
  "No"
  "Si"
  "Medio"
}

Enum "public"."arrePdpVigente" {
  "Si"
  "3 Meses"
  "2 Meses"
  "1 Mes"
  "No"
}

Enum "public"."statusTicket" {
  "Abierto"
  "En Proceso"
  "Cerrado"
}

// Tablas principales

Table "public"."SPHConfiguraciones" {
