Table "public"."cxp" {
  "idCxp" text [pk]
  "fc" timestamp [not null, default: `now()`]
  "status" boolean [default: true]
  "uidr" uuid [ref: < "public"."catUsers"."uid"]
  "estado" text
  "idProveedor" text [ref: < "public"."catProveedores"."idProveedor"]
  "tipoProveedor" integer // 1 = Proveedor, 2 = Inversionista, 3 = Comisionista
  "nombreProveedor" text
  "fecCFDI" date
  "fecSolicitud" date
  "folio" text [unique]
  "idCategoria" text
  "parque" text
  "nave" text
  "concepto" text
  "subtotal" double [default: 0]
  "total" double
  "autorizo" uuid [ref: < "public"."catUsers"."uid"]
  "fecAutorizacion" timestamp
  "pagador" uuid
  "fecPago" timestamp
  "montoAplicado" double [default: 0]
  "urlXLM" text
  "urlCFDI" text
  "numSem" integer // Generada: EXTRACT(week FROM "fecSolicitud")
  "numAnio" integer // Generada: EXTRACT(year FROM fc)
  "numMes" integer // Generada: EXTRACT(month FROM fc)
  "rangoSemana" text
  "ultimoComentario" text [default: '']
  "nomCFDI" text [default: '']
  "idEstado" smallint [default: 1] // 1. Guardado | 2. Enviado | 3. Rechazado | 4. Aprobado | 5. Reprogramado | 6. Pagado | 7. Pago T. Bancaria | 99. Aprobado sin pago aplicado
  "uidGerente" text // Gerente aprobador
  "idMovBancarios" text
  "idCxpPPD" text [ref: < "public"."cxp_ppd"."idCxpPPD"]
  "lineaCaptura" text [unique]
  "referencia" text
  "fechaLimite" date
  "pagoInmediato" boolean
  "esUrgente" boolean [default: false]
  "completada" boolean [default: true]
  "tdc" boolean [default: false] // Pago con tarjeta de SPH
  "moneda" text [default: 'MXN']
  "tipoOperacion" smallint [default: 1] // 1. Solicitud de Pago | 2. Solicitud Urgente |3. Pago TdC | 4. Linea de Captura | 5. Devolución | 6. Factura sin XML
  "nomGerente" text // agrega el nombre del gerente a quien se asigno el pago
  "autorizadoFP" boolean [default: false] // Se solicito Autorizado fuera de Presupuesto
}

