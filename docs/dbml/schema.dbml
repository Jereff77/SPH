Table "public"."fideMesDispersion" {
  "idfideMesDisp" text [pk]
  "status" boolean [default: true]
  "uidr" uuid [ref: < "public"."catUsers"."uid"] // usuario que creo el registro
  "idFide" text [ref: < "public"."fideicomiso"."idFide"]
  "mes" integer
  "dia" integer
}

Table "public"."fidePdpDispersion" {
  "idFidePdpD" text [pk]
  "status" boolean
  "idFideCond" text [ref: < "public"."fideCondiciones"."idfideCond"]
  "monto" double
  "numMov" integer
  "fecfin" date // Fecha de Dispersion
  "dias" integer // Dias de calculo para dispersion
  "rend" double
  "fecini" date
  "comsph" double
  "nombreInversionista" text
  "idPropiedad" text
  "personalidad" text
  "idPdp" text
  "fc" timestamp [not null, default: `now()`]
  "calculo_comsph" double // Generada: CASE WHEN ((monto IS NULL) OR (comsph IS NULL) OR (dias IS NULL)) THEN NULL::double precision ELSE (((monto * (comsph / (100)::double precision)) / (365)::double precision) * (dias)::double precision) END
  "calculo" double // Generada: CASE WHEN ((monto IS NULL) OR (rend IS NULL) OR (dias IS NULL)) THEN NULL::double precision ELSE (((monto * (rend / (100)::double precision)) / (365)::double precision) * (dias)::double precision) END
  "retencion_isr" double // Generada: CASE WHEN ((personalidad = 'Fisica'::text) AND (monto IS NOT NULL) AND (rend IS NOT NULL) AND (dias IS NOT NULL)) THEN ((((monto * (rend / (100)::double precision)) / (365)::double precision) * (dias)::double precision) * (0.10)::double precision) ELSE (0)::double precision END
  "dispersion" double // Generada: CASE WHEN ((personalidad = 'Fisica'::text) AND (monto IS NOT NULL) AND (rend IS NOT NULL) AND (dias IS NOT NULL)) THEN ((((monto * (rend / (100)::double precision)) / (365)::double precision) * (dias)::double precision) * (0.90)::double precision) WHEN ((monto IS NOT NULL) AND (rend IS NOT NULL) AND (dias IS NOT NULL)) THEN (((monto * (rend / (100)::double precision)) / (365)::double precision) * (dias)::double precision) ELSE (0)::double precision END
}

