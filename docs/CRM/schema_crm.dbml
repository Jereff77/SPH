Table "public"."catInmobiliarias" {
  "idInmobiliaria" uuid [pk, not null, default: `gen_random_uuid()`]
  "fc" timestamp [not null, default: `now()`]
  "status" boolean [default: true]
  "uidr" uuid [ref: > "public"."catUsers"."uid"]
  "nombre" text
  "uidRC" uuid [ref: > "public"."catUsers"."uid"]
  "descripcion" text
  "paginaWeb" text
  "telefono" text
  "correo" text
  "nombreRepresentante" text
  "telRepresentante" text
  "correoRepresentante" text
  "puestoRepresentante" text
}

Table "public"."catAsesoresInm" {
  "id" uuid [pk, not null, default: `gen_random_uuid()`]
  "fc" timestamp [not null, default: `now()`]
  "status" boolean [default: true]
  "uidr" uuid [ref: > "public"."catUsers"."uid"]
  "idInmobiliaria" uuid [ref: > "public"."catInmobiliarias"."idInmobiliaria"]
  "nombre" text
  "telefono" text [unique]
  "a" text [unique]
  "correo" text
}

// ============================================================================
// TABLAS DE ACTIVIDADES Y SEGUIMIENTO
// ============================================================================

Table "public"."activity_history" {
  "id" uuid [pk, not null, default: `gen_random_uuid()`]
  "created_at" timestamptz [default: `now()`]
  "lead_id" uuid [ref: > "public"."leads"."id"]
  "name" text
  "activity_date" timestamp
  "message" text
  "heat_level" smallint
  "user_id" uuid [ref: > "public"."catUsers"."uid"]
  "type" text
  "fechaAgenda" timestamptz
  "docs" jsonb
}

Table "public"."agenda" {
  "created_at" timestamptz [default: `now()`]
  "user_ref" uuid [ref: > "public"."catUsers"."uid"]
  "name" text
  "description" text
  "lead_name" text
  "date" timestamp
  "duration" smallint
  "ref" text
  "id" uuid [pk, not null, default: `gen_random_uuid()`]
}

Table "public"."crm_incidencias" {
  "id" bigint [pk]
  "fc" timestamptz [default: `now()`]
  "status" boolean [default: true]
  "idMensaje" text
  "fecha" text
  "date" timestamp
  "messageid" text
  "from" text
  "to" text
  "subject" text
  "cuerpoPlano" text
  "textasHtml" text
  "reference" text
  "cadena" boolean [default: true]
  "fum" timestamp
}

Table "public"."seguimientoComentarios" {
  "idComentario" text [pk]
  "uidr" text
  "status" boolean
  "fc" timestamp [default: `now()`]
  "idCliente" text
  "idLead" text
  "comentario" text
  "fechaComentario" date
}

