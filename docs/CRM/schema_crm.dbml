Table "public"."crm_Etapas" {
  "id" bigint [pk]
  "fc" timestamptz [default: `now()`]
  "uidr" uuid [ref: > "public"."catUsers"."uid"]
  "titulo" text
  "bkColor" text [default: '#39d2c0']
  "txtColor" text [default: '#ffffff']
  "orden" smallint
  "status" boolean [default: true]
  "Posicion" text [default: 'medio']
}

Table "public"."crm_Origen" {
  "id" bigint [pk]
  "fc" timestamptz [default: `now()`]
  "uidc" uuid
  "titulo" text
  "status" boolean [default: true]
  "bkColor" text [default: '#ffffff']
  "txtColor" text [default: '#000000']
}

Table "public"."crm_tipoCliente" {
