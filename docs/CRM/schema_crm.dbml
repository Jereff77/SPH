// ============================================================================
// TABLAS PRINCIPALES DEL CRM
// ============================================================================

Table "public"."leads" {
  "id" uuid [pk, not null, default: `gen_random_uuid()`]
  "uidr" uuid [ref: > "public"."catUsers"."uid"]
  "status" boolean [default: true]
  "fc" timestamp [not null, default: `now()`]
  "nombreLead" text
  "telefono" text
  "correo" text
  "idInmobiliaria" uuid [ref: > "public"."catInmobiliarias"."idInmobiliaria"]
  "fechaContacto" timestamp [default: `now()`]
  "fechaRegistro" timestamp [default: `now()`]
  "mensaje" text
  "uidRC" uuid [ref: > "public"."catUsers"."uid"]
  "idEtapa" bigint [ref: > "public"."crm_Etapas"."id"]
  "idOrigen" bigint [default: 0, ref: > "public"."crm_Origen"."id"]
  "idTipoCliente" bigint [default: 0, ref: > "public"."crm_tipoCliente"."id"]
  "idTipoOperacion" bigint [default: 0, ref: > "public"."crm_tipoOperaciones"."id"]
  "idTipoVenta" bigint [ref: > "public"."crm_tipoVenta"."id"]
  "Etapa" text
  "Origen" text
  "tipoCliente" text
  "tipoOperacion" text
  "tipoVenta" text
  "nomRC" text [default: 'Sin asignar']
  "valor" double [default: 0]
  "Aprobado" boolean [default: false]
  "idAsesorInm" uuid [ref: > "public"."catAsesoresInm"."id"]
}

