# -----------------------------------------------------------------------------
# Variables de Entorno - CRM Ventas SPH
# Plantilla para configuración en EasyPanel
# -----------------------------------------------------------------------------

# Supabase Configuration
# URL del proyecto Supabase (obtener desde: https://supabase.com/dashboard > Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://szjlkvakwljssdnysazp.supabase.co

# Clave anónima de Supabase para acceso público (obtener desde: https://supabase.com/dashboard > Settings > API)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Application Environment
# Entorno de ejecución: production | development
NODE_ENV=production

# Optional: Custom Domain
# URL de la aplicación (para producción con dominio configurado)
# NEXT_PUBLIC_APP_URL=https://crm.sph-binesraices.com

# Optional: Email Configuration (SMTP)
# La configuración SMTP se guarda en la tabla crm_config de Supabase
# No es necesario configurarla aquí
